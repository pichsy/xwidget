<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============ WheelView 公共属性定义 ============ -->
    
    <!-- 布局方向 -->
    <attr name="xp_wheelOrientation">
        <enum name="vertical" value="1"/>
        <enum name="horizontal" value="0"/>
    </attr>

    <!-- 中间分割线外的item数量,整个滑动数量就为 wheelItemCount * 2 + 1  -->
    <attr name="xp_wheelItemCount" format="integer"/>

    <!-- 滑轮item高度 -->
    <attr name="xp_wheelItemSize" format="dimension"/>

    <!-- 水平布局时不考虑只参数,  当垂直布局时的左右靠齐立体效果 -->
    <attr name="xp_wheelGravity">
        <enum name="center" value="0"/>
        <enum name="left" value="1"/>
        <enum name="right" value="2"/>
    </attr>

    <!-- 滑轮字体大小 -->
    <attr name="xp_wheelTextSize" format="dimension"/>

    <!-- 滑轮字体颜色 -->
    <attr name="xp_wheelTextColor" format="color"/>

    <!-- 滑轮中心字体颜色 -->
    <attr name="xp_wheelTextCenterColor" format="color"/>

    <!--   颜色透明度是否渐变     -->
    <attr name="xp_wheelGradient" format="boolean"/>

    <!-- 分割线大小 -->
    <attr name="xp_wheelDividerSize" format="dimension"/>

    <!-- 分割线颜色 -->
    <attr name="xp_wheelDividerColor" format="color"/>

    <!-- 分割线填充值默认为0, 分割线矩阵大小为itemSize + dividerPadding -->
    <attr name="xp_wheelDividerPadding" format="dimension"/>

    <!-- 选中文字是否加粗 -->
    <attr name="xp_wheelTextSelectedBold" format="boolean"/>

    <!-- 未选中文字是否加粗 -->
    <attr name="xp_wheelTextNormalBold" format="boolean"/>

    <!-- ============ XWheelView 样式集合 ============ -->
    
    <!-- XWheelView -->
    <declare-styleable name="XWheelView">
        <attr name="xp_wheelOrientation"/>
        <attr name="xp_wheelItemCount"/>
        <attr name="xp_wheelItemSize"/>
        <attr name="xp_wheelGravity"/>
        <attr name="xp_wheelTextSize"/>
        <attr name="xp_wheelTextColor"/>
        <attr name="xp_wheelTextCenterColor"/>
        <attr name="xp_wheelGradient"/>
        <attr name="xp_wheelDividerSize"/>
        <attr name="xp_wheelDividerColor"/>
        <attr name="xp_wheelDividerPadding"/>
        <attr name="xp_wheelTextSelectedBold"/>
        <attr name="xp_wheelTextNormalBold"/>
    </declare-styleable>

</resources>